{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "always-link-local": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "Performance",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    },
    {
      "type": "ci",
      "section": "CI/CD",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": false
    }
  ],
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "release-type": "simple",
      "prerelease-type": "alpha",
      "include-component-in-tag": false,
      "component": "solpan",
      "extra-files": [
        "gradle.properties"
      ]
    }
  }
}
